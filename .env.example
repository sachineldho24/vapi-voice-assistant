PORT=3000
# Optional. If set, Vapi must send: Authorization: Bearer <WEBHOOK_TOKEN>
WEBHOOK_TOKEN=
# Optional fixed date for a deterministic demo. Otherwise the server uses UTC today.
DEMO_TODAY=2026-08-15

# Read only by scripts/vapi_provision.mjs, never by the server.
# .env is gitignored and is not included in the submission archive.
VAPI_API_KEY=
VAPI_WEBHOOK_CREDENTIAL_ID=
