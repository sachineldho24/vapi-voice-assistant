      "parameters": {
        "type": "object",
        "properties": {
          "channel": { "type": "string", "enum": ["SMS", "WHATSAPP"] }
        },
        "required": ["channel"],
        "additionalProperties": false
      }
    },
    "server": { "url": "https://economics-saturday-kansas-baths.trycloudflare.com/webhook" }
